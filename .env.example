# ─────────────────────────────────────────────────────────────
# Base de données (requis)
# ─────────────────────────────────────────────────────────────
DATABASE_URL="mysql://user:password@localhost:3306/pubg_clan_smk"

# ─────────────────────────────────────────────────────────────
# API PUBG
# ─────────────────────────────────────────────────────────────
PUBG_API_KEY="your-pubg-api-key"
PUBG_BASE_URL="https://api.pubg.com"
# Limite de requêtes PUBG API en requests/minute. Défaut : 10 (plan gratuit).
# Ajuster selon votre niveau d'abonnement API PUBG.
# PUBG_API_RATE_LIMIT_RPM="10"

# ─────────────────────────────────────────────────────────────
# URLs applicatives
# ─────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# URL interne pour les appels API self-to-self (cron → sync-matches, etc.).
# Doit être joignable depuis le process Node.js. Défaut : valeur de APP_URL.
INTERNAL_APP_URL="http://127.0.0.1:3000"
# Port d'écoute interne (process séparé cron bootstrap). Défaut : 3001.
# PORT="3001"

# ─────────────────────────────────────────────────────────────
# Auth & Bootstrap
# ─────────────────────────────────────────────────────────────
# Active la compatibilité avec l'ancien format d'actor_id (migration).
AUTH_ALLOW_LEGACY_ACTOR_ID="false"
# Secret pour le bootstrapping du premier compte SuperUser via /api/auth/bootstrap.
AUTH_BOOTSTRAP_SECRET="change-me-long-random-string"

# ─────────────────────────────────────────────────────────────
# Email / SMTP (optionnel — désactivé si SMTP_HOST est vide)
# ─────────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PUBG Clan <no-reply@localhost>"

# ─────────────────────────────────────────────────────────────
# Cron scheduler
# ─────────────────────────────────────────────────────────────
# Active le scheduler node-cron dans le process Next.js (instrumentation.ts).
ENABLE_CRON_JOBS="false"

# Active un endpoint HTTP interne (/api/internal/cron/status) sur le port PORT
# pour permettre au web worker de sonder l'état du cron scheduler.
# Nécessite CRON_BOOTSTRAP_SECRET.
# ENABLE_CRON_BOOTSTRAP="false"

# Secret partagé entre le web worker et la route interne /api/internal/cron/*.
# Requis si ENABLE_CRON_BOOTSTRAP=true ou si INTERNAL_CRON_STATUS_URL est utilisé.
# CRON_BOOTSTRAP_SECRET="change-me-cron-secret"

# URL sondée par la page /settings/cron pour vérifier le statut du cron worker.
# Défaut : http://127.0.0.1:3001/api/internal/cron/status
# INTERNAL_CRON_STATUS_URL="http://127.0.0.1:3001/api/internal/cron/status"

# ─────────────────────────────────────────────────────────────
# Schedules cron (expressions cron, optionnelles — valeurs par défaut incluses)
# ─────────────────────────────────────────────────────────────
# Timezone appliquée à toutes les expressions cron.
CLAN_MATCH_SYNC_TIMEZONE="UTC"

# Synchronisation des matchs du clan depuis l'API PUBG. Défaut : 02:00 chaque nuit.
CLAN_MATCH_SYNC_CRON="0 2 * * *"
# Recalcul des statistiques agrégées du clan. Défaut : 03:00 chaque nuit.
CLAN_STATS_RECALC_CRON="0 3 * * *"
# Sync des stats lifetime (toutes saisons) depuis l'API PUBG. Défaut : 04:00 chaque nuit.
CLAN_LIFETIME_STATS_SYNC_CRON="0 4 * * *"
# Sync des stats de la saison courante. Défaut : 05:00 chaque nuit.
CLAN_SEASON_STATS_SYNC_CRON="0 5 * * *"
# Rappel de présence en ligne (notification). Défaut : 18:00 chaque jour.
CLAN_ONLINE_REMINDER_CRON="0 18 * * *"
# Génération du rapport hebdomadaire (chaque lundi). Défaut : lundi 08:00.
WEEKLY_REPORT_GENERATION_CRON="0 8 * * 1"
# Rappel de rapport hebdomadaire (notification). Défaut : 09:00 chaque jour.
WEEKLY_REPORT_REMINDER_CRON="0 9 * * *"
# Génération du rapport mensuel (1er du mois). Défaut : 1er du mois à 08:00.
MONTHLY_REPORT_GENERATION_CRON="0 8 1 * *"

# ─────────────────────────────────────────────────────────────
# Télémétrie — synchronisation (cron daily_sync)
# ─────────────────────────────────────────────────────────────
# Active la sync télémétrie dans le job daily_sync.
# Si false, les matchs sont importés mais les fichiers de télémétrie ne sont pas téléchargés.
TELEMETRY_SYNC_ENABLED="false"
# Version du parser télémétrie. Défaut : v1.
# TELEMETRY_PARSER_VERSION="v1"
# Nombre max de matchs traités par run de sync télémétrie. Défaut : 50.
# TELEMETRY_MAX_MATCHES_PER_RUN="50"
# Concurrence de téléchargement des fichiers de télémétrie. Défaut : 2.
# TELEMETRY_SYNC_CONCURRENCY="2"
# Nombre max de tentatives par fichier en cas d'erreur réseau transitoire. Défaut : 2.
# TELEMETRY_RETRY_MAX="2"
# Délai de base (ms) entre tentatives (exponentiel). Défaut : 500.
# TELEMETRY_RETRY_BASE_DELAY_MS="500"
# Timeout de téléchargement d'un fichier de télémétrie (ms). Défaut : 30000.
# TELEMETRY_FETCH_TIMEOUT_MS="30000"
# Taille max d'un fichier de télémétrie accepté (Mo). Défaut : 250.
# TELEMETRY_MAX_ASSET_SIZE_MB="250"
# Taille des batches d'écriture des agrégats en base. Défaut : 250.
# TELEMETRY_AGGREGATES_WRITE_BATCH_SIZE="250"

# ─────────────────────────────────────────────────────────────
# Télémétrie — debug / capture de fixtures
# (réservé au développement, ne pas activer en production)
# ─────────────────────────────────────────────────────────────
# Active la capture locale des fichiers de télémétrie bruts pour tests/debug.
# TELEMETRY_CAPTURE_FIXTURES="false"
# Répertoire de destination des fixtures capturées. Requis si CAPTURE_FIXTURES=true.
# TELEMETRY_CAPTURE_FIXTURES_DIR="/tmp/pubg-telemetry-fixtures"
# Taille max d'un fichier capturé (octets). Défaut : 10485760 (10 Mo). Plafond dur : 50 Mo.
# TELEMETRY_CAPTURE_FIXTURE_MAX_BYTES="10485760"
# Intervalle d'échantillonnage des positions (secondes). Calculé dynamiquement si absent.
# TELEMETRY_POSITION_SAMPLE_INTERVAL_SECONDS=""
# Rayon de clustering des tirs (mètres). Défaut : 50.
# TELEMETRY_SHOT_CLUSTER_RADIUS_METERS="50"
# Rayon de clustering des dégâts (mètres). Défaut : 30.
# TELEMETRY_DAMAGE_CLUSTER_RADIUS_METERS="30"

# ─────────────────────────────────────────────────────────────
# Worker resync télémétrie (npm run telemetry:worker)
# ─────────────────────────────────────────────────────────────
# Délai de polling entre deux recherches de job (ms). Défaut : 2000.
# TELEMETRY_RESYNC_WORKER_POLL_MS="2000"
# Identifiant du worker (affiché dans les logs et le lock file). Défaut : pid-<PID>.
# TELEMETRY_RESYNC_WORKER_ID=""
# Parallélisme max du worker resync. Défaut : 1 (séquentiel).
# TELEMETRY_RESYNC_WORKER_MAX_PARALLEL="1"
# Chemin du fichier lock single-instance. Défaut : .telemetry-resync-worker.lock
# TELEMETRY_RESYNC_WORKER_LOCK_FILE=".telemetry-resync-worker.lock"
# Durée après laquelle un lock est considéré périmé (ms). Défaut : 1800000 (30 min).
# TELEMETRY_RESYNC_WORKER_LOCK_STALE_MS="1800000"
# Durée après laquelle un job en running est récupéré au démarrage (ms). Défaut : 120000.
# TELEMETRY_RESYNC_STUCK_RECOVERY_MS="120000"
# Seuil mémoire (%) déclenchant la backpressure (pause). Défaut : 80.
# TELEMETRY_WORKER_MEMORY_THRESHOLD_PCT="80"
# Seuil mémoire critique (%) déclenchant l'arrêt du worker. Défaut : 95.
# TELEMETRY_WORKER_MEMORY_CRITICAL_PCT="95"
# Active le GC manuel entre les jobs (si disponible). Défaut : true si global.gc existe.
# TELEMETRY_WORKER_GC_ENABLED="true"

# ─────────────────────────────────────────────────────────────
# Worker agrégats télémétrie (npm run telemetry:aggregates:worker)
# ─────────────────────────────────────────────────────────────
# Délai de polling entre deux recherches de job (ms). Défaut : 3000.
# TELEMETRY_AGGREGATE_WORKER_POLL_MS="3000"
# Identifiant du worker. Défaut : aggregate-pid-<PID>.
# TELEMETRY_AGGREGATE_WORKER_ID=""
# Parallélisme max. Défaut : 1.
# TELEMETRY_AGGREGATE_WORKER_MAX_PARALLEL="1"
# Chemin du fichier lock. Défaut : .telemetry-aggregate-worker.lock
# TELEMETRY_AGGREGATE_WORKER_LOCK_FILE=".telemetry-aggregate-worker.lock"
# Durée après laquelle un lock est périmé (ms). Défaut : 1800000 (30 min).
# TELEMETRY_AGGREGATE_WORKER_LOCK_STALE_MS="1800000"

# ─────────────────────────────────────────────────────────────
# Tests uniquement (Vitest) — ne pas définir en production
# ─────────────────────────────────────────────────────────────
# Active les tests d'intégration sur les fixtures capturées réelles.
# TELEMETRY_TEST_CAPTURED_FIXTURES="false"
# Nombre max de fichiers fixture testés. Défaut : 3.
# TELEMETRY_TEST_CAPTURED_FIXTURES_MAX_FILES="3"
# Budget de parse max par fixture (ms). Défaut : 2000.
# TELEMETRY_TEST_CAPTURED_FIXTURE_MAX_PARSE_MS="2000"
