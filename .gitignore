# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.log
*.lock
server.txt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/src/lib/pubg-telemetry/__fixtures__/captured/
/.telemetry-captured/

# fichiers téléversés (images de clan) : données de production, jamais versionnées.
# Ignorés, ils survivent à un `git clean -fd` ou à un `git stash -u` (docs/ops/deployment.md §Fichiers téléversés).
/public/uploads/

# pubg assets visuels (générés par npm run sync:pubg-assets)
/public/icons/pubg/
server.txt

# Playwright (docs/ops/tests-e2e.md)
/test-results/
/playwright-report/
/blob-report/

/docs/ui/refonte/
# pages remplacées par la refonte UI, gardées pour mémoire (archive/README.md) : jamais compilées ni versionnées
/archive/
