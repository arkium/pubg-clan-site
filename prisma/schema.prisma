// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Clan {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  tag           String
  platformShard String   @default("steam")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members ClanMember[]

  @@map("Clan")
}

model ClanMember {
  id             Int      @id @default(autoincrement())
  displayName    String
  pubgPlayerName String   @unique
  pubgAccountId  String?
  platformShard  String   @default("steam")
  isActive       Boolean  @default(true)
  clanId         Int?
  clan           Clan?    @relation(fields: [clanId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  matches       Match[]
  lifetimeStats MemberLifetimeStats?
  squadMembers  SquadMember[]
  playerStats   PlayerStats[]

  @@map("ClanMember")
}

model Match {
  id       String     @id
  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  pubgMatchId String
  gameMode    String
  mapName     String

  kills         Int
  knockouts     Int
  assists       Int
  damageDealt   Float
  headshotKills Int
  revives       Int

  placement    Int
  playersAlive Int

  duration      Int
  pubgCreatedAt DateTime

  createdAt DateTime @default(now())

  @@unique([memberId, pubgMatchId])
  @@map("Match")
}

model SquadMatch {
  id          String   @id @default(cuid())
  pubgMatchId String   @unique
  gameMode    String
  mapName     String
  placement   Int
  createdAt   DateTime

  members SquadMember[]

  totalKills   Int
  totalDamage  Float
  totalAssists Int
  totalRevives Int

  @@map("SquadMatch")
}

model SquadMember {
  id           String     @id @default(cuid())
  squadMatchId String
  squadMatch   SquadMatch @relation(fields: [squadMatchId], references: [id], onDelete: Cascade)

  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  kills     Int
  damage    Float
  assists   Int
  revives   Int
  placement Int

  @@unique([squadMatchId, memberId])
  @@map("SquadMember")
}

model PlayerStats {
  id         String     @id @default(cuid())
  memberId   Int
  member     ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  period     String // "week-2026-20", "month-2026-05", "all-time"
  periodType String // "week" | "month" | "all"
  startDate  DateTime
  endDate    DateTime

  totalKills       Int   @default(0)
  totalDamage      Float @default(0)
  totalAssists     Int   @default(0)
  totalRevives     Int   @default(0)
  matchesPlayed    Int   @default(0)
  matchesWon       Int   @default(0)
  winRate          Float @default(0)
  avgKillsPerGame  Float @default(0)
  avgDamagePerGame Float @default(0)

  badgeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, period])
  @@map("PlayerStats")
}

model MemberLifetimeStats {
  id       Int        @id @default(autoincrement())
  memberId Int        @unique
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  combat   Json
  victory  Json
  support  Json
  vehicle  Json
  movement Json
  other    Json

  lastRefreshedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("MemberLifetimeStats")
}
