model Challenge {
  id     String @id @default(cuid())
  clanId Int
  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)

  title       String
  description String?
  type        String

  startDate DateTime
  endDate   DateTime
  duration  String

  target   Int?
  criteria Json

  rewards   Json
  topReward Int?

  status String

  createdAt DateTime @default(now())

  participants ChallengeParticipant[]

  @@index([clanId, status, endDate])
  @@map("Challenge")
}

model ChallengeParticipant {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  progress Int
  rank     Int?
  reward   Int?

  joinedAt   DateTime  @default(now())
  finishedAt DateTime?

  @@unique([challengeId, memberId])
  @@map("ChallengeParticipant")
}

model ChallengeReward {
  id String @id @default(cuid())

  name        String
  description String?
  icon        String?

  points Int
  badge  String?

  @@map("ChallengeReward")
}

model PlayerRewards {
  id       String     @id @default(cuid())
  memberId Int        @unique
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  totalPoints Int  @default(0)
  badges      Json

  updatedAt DateTime @updatedAt

  @@map("PlayerRewards")
}

model CronExecution {
  id String @id @default(cuid())

  clanId Int
  clan   Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  action      String
  status      String
  triggeredBy Int?
  source      String @default("manual")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  message String?
  details Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clanId, startedAt])
  @@index([clanId, action, status])
  @@map("CronExecution")
}

model CronSchedule {
  key        String   @id
  expression String
  timezone   String   @default("UTC")
  updatedAt  DateTime @updatedAt
  updatedBy  Int?

  @@map("CronSchedule")
}

model PubgApiCallLog {
  id String @id @default(cuid())

  source String @default("gateway")

  method   String
  endpoint String
  shard    String?

  statusCode Int?
  success    Boolean @default(false)
  retryCount Int     @default(0)

  rateLimitLimit     Int?
  rateLimitRemaining Int?
  rateLimitResetAt   DateTime?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  clanId   Int?
  memberId Int?

  errorMessage String?

  createdAt DateTime @default(now())

  @@index([startedAt])
  @@index([statusCode, startedAt])
  @@index([rateLimitResetAt])
  @@index([source, startedAt])
  @@map("PubgApiCallLog")
}

model NavItem {
  id              Int      @id @default(autoincrement())
  navKey          String   @unique
  section         String
  label           String
  hrefTemplate    String
  defaultRole     String
  description     String   @default("")
  sortOrder       Int      @default(0)
  sectionOverride String?
  roleOverride    String?
  labelOverride   String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([section, sortOrder])
  @@map("NavItem")
}

model SystemStatsCache {
  id     String @id @default(cuid())
  period String // 'week' | 'month' | 'all'

  // Compteurs globaux
  trackedClanCount      Int @default(0) // Nombre total de clans suivis
  opponentClanCount     Int @default(0) // Nombre total de clans adversaires croisés
  totalEncounters       Int @default(0) // Nombre total de rencontres
  noClanPlayerCount     Int @default(0) // Joueurs croisés SANS clan
  withClanPlayerCount   Int @default(0) // Joueurs croisés AVEC clan
  trackedClanMatchCount Int @default(0) // Nombre total de matchs analysés
  uniquePlayersCount    Int @default(0) // Nombre total de joueurs uniques croisés

  computedAt DateTime @default(now())

  @@unique([period])
  @@map("SystemStatsCache")
}
