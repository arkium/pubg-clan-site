model Match {
  id       String     @id
  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  pubgMatchId String
  gameMode    String
  matchType   String @default("official")
  mapName     String

  kills         Int
  knockouts     Int
  assists       Int
  damageDealt   Float
  headshotKills Int
  revives       Int

  placement    Int
  playersAlive Int

  duration Int
  // Le DEFAULT CURRENT_TIMESTAMP(3) existe en base mais n'est jamais utilise :
  // la date vient toujours de l'API PUBG cote applicatif. Declare uniquement
  // pour aligner le schema sur la base — ne jamais compter dessus, un match
  // enregistre a l'heure courante fausserait toutes les periodes.
  pubgCreatedAt DateTime @default(now())

  // Nombre de bots distincts (accountId préfixé ai.) dans le lobby complet du
  // match — nullable, calculé uniquement pour les matchs synchronisés depuis
  // l'ajout de ce champ, pas de backfill.
  botCount Int?

  createdAt DateTime @default(now())

  @@unique([memberId, pubgMatchId])
  @@index([pubgMatchId], map: "idx_match_pubg_match_id")
  @@map("Match")
}

