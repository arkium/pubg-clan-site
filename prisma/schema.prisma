// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Clan {
  id                  Int       @id @default(autoincrement())
  name                String
  tag                 String
  platformShard       String    @default("steam")
  pubgClanId          String?
  clanStats           Json?
  clanLevel           Int?
  clanPoints          Int?
  pubgCreatedAt       DateTime?
  pubgMemberCount     Int?
  pubgMembersSyncedAt DateTime?
  lastMatchAt         DateTime?
  missingMembersCount Int       @default(0)
  isActive            Boolean   @default(true)
  // Clan technique du site (ex. "Ungrouped" / UNG) : parking des joueurs sans clan
  // qu'on continue de suivre. Un clan systeme n'est jamais renomme ni absorbe par
  // un clan PUBG — voir docs/TODO/todo.md, chantier 0 du cycle de vie de clan.
  isSystem            Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  members                   ClanMember[]
  roles                     ClanRole[]
  clanSynergyTelemetryStats ClanSynergyTelemetryStats[]
  challenges                Challenge[]
  invites                   MemberInvite[]
  cronExecutions            CronExecution[]
  clanConfigs               ClanConfig[]
  positionMetricCells       PositionMetricCell[]
  zoneClosurePositions      ZoneClosurePosition[]
  encounteredPlayers        EncounteredPlayer[]
  killEvents                KillEvent[]
  awardsCache               ClanAwardsCache[]
  matchesCache              ClanMatchesCache[]
  comparatorCache           ClanComparatorCache[]
  clanEncounters            ClanEncounter[]
  organizedTournaments      Tournament[]      @relation("TournamentOrganizer")
  discordNotifications      DiscordNotificationLog[]
  clanChangesAsPrevious     PlayerClanChange[]          @relation("PlayerClanChangePrevious")
  clanChangesAsNew          PlayerClanChange[]          @relation("PlayerClanChangeNew")

  @@unique([name, platformShard])
  @@unique([pubgClanId, platformShard])
  @@index([lastMatchAt])
  @@map("Clan")
}

model ClanMember {
  id             Int      @id @default(autoincrement())
  displayName    String
  pubgPlayerName String
  pubgAccountId  String?
  platformShard  String   @default("steam")
  isActive       Boolean  @default(true)
  joinStatus     String   @default("active")
  lastMatchAt    DateTime?
  clanId         Int?
  clan           Clan?    @relation(fields: [clanId], references: [id], onDelete: SetNull)
  playerId       String?
  player         Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  // Archivage d'un membre du clan technique reste trop longtemps sans jouer
  // (chantier 5). Distingue une purge d'un arret de suivi ordinaire : isActive
  // vaut false dans les deux cas, seul archivedReason dit pourquoi.
  archivedAt     DateTime?
  archivedReason String?
  // Email de contact saisi sur /join lors d'une demande de creation de clan
  // (chantier 4). Porte par ClanMember parce que c'est la seule table qui
  // connait deja le pseudo du demandeur a ce stade : UserAccount n'existe pas
  // encore (passwordHash non nullable) et Clan perdrait le lien avec le joueur.
  // Repris comme UserAccount.email a l'activation du compte.
  contactEmail   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  matches                   Match[]
  lifetimeStats             MemberLifetimeStats?
  seasonStats               MemberSeasonStats[]
  weaponMastery             MemberWeaponMastery[]
  squadMembers              SquadMember[]
  playerStats               PlayerStats[]
  memberWeaponStats         MemberWeaponStats[]
  memberTelemetryStats      MemberTelemetryStats[]
  dropPressureStats         DropPressureStat[]
  positionMetricCells       PositionMetricCell[]
  zoneClosurePositions      ZoneClosurePosition[]
  killEventsAsKiller        KillEvent[]                 @relation("KillEventKiller")
  killEventsAsVictim        KillEvent[]                 @relation("KillEventVictim")
  throwableStats            MemberThrowableStat[]
  itemUseStats              MemberItemUseStat[]
  telemetrySynergyAsMemberA ClanSynergyTelemetryStats[] @relation("TelemetrySynergyMemberA")
  telemetrySynergyAsMemberB ClanSynergyTelemetryStats[] @relation("TelemetrySynergyMemberB")
  notifications             Notification[]
  notificationPreference    NotificationPreference?
  roles                     ClanMemberRole[]
  challengeParticipants     ChallengeParticipant[]
  playerRewards             PlayerRewards?
  invites                   MemberInvite[]
  identities                MemberIdentity[]
  sentInvites               MemberInvite[]              @relation("InviteSender")
  activeSessions            UserSession[]               @relation("SessionActiveMember")
  clanChanges               PlayerClanChange[]

  @@unique([pubgPlayerName, platformShard])
  @@index([clanId, lastMatchAt])
  @@index([pubgAccountId], map: "idx_clan_member_pubg_account")
  @@map("ClanMember")
}

// Adversaires (hors clan suivi) croisés en match par un clan tracké. Table
// volontairement séparée de ClanMember/Clan — sert d'observation légère
// (fréquence de croisement, clan PUBG résolu à la demande), pas de tracking actif.
// Voir docs/TODO/todo.md, section "Idées — Suivi des adversaires rencontrés en match".
model EncounteredPlayer {
  id     String @id @default(cuid())
  clanId Int
  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)

  pubgAccountId  String
  pubgPlayerName String
  platformShard  String

  // Identité globale correspondante (Player.pubgAccountId+platformShard).
  // Nullable : backfillée pour les comptes déjà résolus, sinon peuplée à la
  // prochaine résolution — permet de joindre vers Player sans requête
  // supplémentaire par pubgAccountId+platformShard.
  playerId String?
  player   Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  // Résolution du clan PUBG de ce joueur — nullable tant que non résolu.
  // clanResolvedAt marque qu'une tentative a eu lieu (succès ou "pas de clan"),
  // pour ne jamais rappeler l'API PUBG deux fois pour le même joueur.
  pubgClanId      String?
  pubgClanTag     String?
  pubgClanName    String?
  clanResolvedAt  DateTime?
  resolveAttempts Int       @default(0)

  encounterCount         Int      @default(1)
  // Sous-ensemble de encounterCount : nombre de fois où ce joueur partageait le
  // roster (la squad) d'un membre suivi — un coéquipier occasionnel, pas un
  // adversaire. opponentEncounterCount (encounterCount - teammateEncounterCount)
  // se calcule à la lecture, pas stocké séparément.
  teammateEncounterCount Int      @default(0)
  firstSeenAt            DateTime @default(now())
  lastSeenAt             DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  combatInteractionsCount Int @default(0)

  @@unique([clanId, pubgAccountId])
  @@index([clanId, encounterCount])
  @@index([clanId, pubgClanTag])
  @@index([clanResolvedAt, encounterCount])
  @@index([clanResolvedAt, resolveAttempts, encounterCount], map: "idx_ep_resolution")
  @@index([clanResolvedAt, pubgClanTag], map: "idx_ep_resolved_clan")
  @@index([lastSeenAt], map: "idx_ep_last_seen")
  @@index([clanResolvedAt, combatInteractionsCount])
  @@index([playerId])
  @@index([pubgPlayerName], map: "idx_encountered_player_name")
  // Sert le regroupement par identité globale (priorisation cross-clan du
  // résolveur) : combien de clans distincts ont croisé ce compte, encore non
  // résolu.
  @@index([pubgAccountId, platformShard, clanResolvedAt])
  @@map("EncounteredPlayer")
}

// Identité globale d'un joueur PUBG croisé (adversaire ou coéquipier de match)
// par un clan suivi, normalisée pour éviter de dupliquer nom/résolution de clan
// une fois par clan qui l'observe (voir EncounteredPlayer ci-dessus, encore en
// écriture double pendant la transition — docs/TODO/todo.md).
model Player {
  id             String @id @default(cuid())
  pubgAccountId  String
  platformShard  String @default("steam")
  pubgPlayerName String

  opponentClanId String?
  opponentClan   OpponentClan? @relation(fields: [opponentClanId], references: [id], onDelete: SetNull)

  // Même sémantique que EncounteredPlayer.clanResolvedAt/resolveAttempts, mais
  // portée globalement : un joueur n'est résolu qu'une seule fois, pas une fois
  // par clan suivi qui l'a croisé.
  clanResolvedAt  DateTime?
  resolveAttempts Int       @default(0)

  isFavorite  Boolean  @default(false)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  encounters            ClanEncounter[]
  clanMembers           ClanMember[]
  encounteredPlayerRows EncounteredPlayer[]

  @@unique([pubgAccountId, platformShard])
  @@index([opponentClanId])
  @@index([pubgPlayerName])
  @@index([clanResolvedAt], map: "idx_player_clan_resolved")
  // Index compose herite, cree hors migration. Aucune requete Prisma actuelle
  // ne filtre Player sur (clanResolvedAt, lastSeenAt) — declare ici pour
  // aligner le schema sur la base plutot que de le laisser supprimer par un
  // `db push`.
  @@index([clanResolvedAt, lastSeenAt], map: "idx_player_resolved_last_seen")
  @@map("Player")
}

// Identité globale d'un clan PUBG adverse, partagée entre tous les clans
// suivis qui l'ont croisé (remplace la duplication de pubgClanTag/pubgClanName
// en texte libre sur chaque ligne EncounteredPlayer).
model OpponentClan {
  id            String   @id @default(cuid())
  pubgClanId    String
  platformShard String   @default("steam")
  tag           String?
  name          String?
  isFavorite    Boolean  @default(false)
  resolvedAt    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players Player[]
  stats   OpponentClanStatsCache[]

  @@unique([pubgClanId, platformShard])
  @@index([isFavorite])
  @@map("OpponentClan")
}

model OpponentClanStatsCache {
  id             String       @id @default(cuid())
  opponentClanId String
  opponentClan   OpponentClan @relation(fields: [opponentClanId], references: [id], onDelete: Cascade)

  period    String // 'week' | 'month' | 'all'
  periodKey String

  asOpponentCount   Int      @default(0)
  asTeammateCount   Int      @default(0)
  lastSeenAt        DateTime
  memberCount       Int      @default(0)
  trackedClansCount Int      @default(0)

  computedAt DateTime @default(now())

  @@unique([opponentClanId, period])
  @@index([period, asOpponentCount(sort: Desc)])
  @@index([period, asTeammateCount(sort: Desc)])
  @@index([period, lastSeenAt(sort: Desc)])
  @@map("OpponentClanStatsCache")
}

// Fait "clan suivi X a croisé le joueur Y" — remplace progressivement
// EncounteredPlayer avec une identité de joueur partagée au lieu d'une copie
// par clan. Le clan adverse d'une rencontre se lit via player.opponentClan,
// pas dénormalisé ici.
model ClanEncounter {
  id     String @id @default(cuid())
  clanId Int
  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  encounterCount         Int @default(1)
  teammateEncounterCount Int @default(0)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clanId, playerId])
  @@index([clanId, encounterCount])
  @@map("ClanEncounter")
}

// Journal des passages du résolveur de clan adverse (cron transverse à tous
// les clans, ou déclenchement manuel SuperUser) — pas de clanId ici
// contrairement à CronExecution, ce job n'est pas scopé à un seul clan.
model EncounteredPlayerResolutionRun {
  id String @id @default(cuid())

  source String @default("cron") // 'cron' | 'manual'
  status String @default("running") // 'running' | 'success' | 'failed'

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  // candidatesSelected = nombre de relations clan-joueur (lignes EncounteredPlayer)
  // représentées par le batch, uniqueCandidatesSelected = nombre d'identités
  // globales distinctes réellement sélectionnées (ce qui borne le batch et le
  // nombre d'appels PUBG potentiels) — un candidat croisé par 3 clans compte
  // pour 3 dans candidatesSelected mais 1 dans uniqueCandidatesSelected.
  candidatesSelected  Int @default(0)
  resolvedFromCache   Int @default(0)
  pubgApiCalls        Int @default(0)
  resolvedWithClan    Int @default(0)
  resolvedWithoutClan Int @default(0)
  failed              Int @default(0)

  uniqueCandidatesSelected    Int    @default(0)
  crossClanCandidatesSelected Int    @default(0)
  encounterRowsUpdated        Int    @default(0)
  rowsResolvedPerApiCall      Float?

  backlogRemaining         Int?
  rateLimitRemainingBefore Int?
  rateLimitRemainingAfter  Int?

  // Non nul uniquement pour source='manual' — sert aussi de journal d'audit
  // pour l'action "Résoudre maintenant" (pas de table d'audit séparée).
  triggeredByUserId Int?
  errorMessage      String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startedAt])
  @@index([status, startedAt])
  @@map("EncounteredPlayerResolutionRun")
}

// Passage du cron de synchronisation d'appartenance — cycle de vie du clan d'un
// joueur (docs/TODO/todo.md, section P2, garde-fou D de « Surete d'execution »).
//
// Table dediee plutot que CronExecution, dont le clanId est obligatoire alors que
// ce cron est global. Sert aussi de verrou : un passage refuse de demarrer si un
// autre est encore `running`, et de point de rattachement au revert par lot via
// PlayerClanChange.runId.
model ClanLifecycleRun {
  id String @id @default(cuid())

  // cron | manual
  source String @default("cron")
  // running | success | failed | aborted
  status String @default("running")
  // observe | apply — mode effectif au moment du passage
  mode String @default("observe")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  membersScanned   Int @default(0)
  apiCalls         Int @default(0)
  statesHasClan    Int @default(0)
  statesNoClan     Int @default(0)
  statesUnknown    Int @default(0)

  discrepanciesFound   Int @default(0)
  // Ecarts vus mais pas encore confirmes N fois — ils n'ont produit aucun mouvement.
  awaitingConfirmation Int @default(0)
  movementsPlanned     Int @default(0)
  movementsApplied     Int @default(0)

  circuitBreakerTripped Boolean @default(false)
  movesRatioPercent     Float?

  triggeredByUserId Int?
  errorMessage      String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startedAt])
  @@index([startedAt])
  @@map("ClanLifecycleRun")
}

// Journal des changements de clan d'un joueur — cycle de vie du clan d'un joueur
// (docs/TODO/todo.md, section P2). Trace chaque mouvement, qu'il soit automatique
// (cron de synchronisation d'appartenance) ou manuel (bascule par un Owner), et
// permet de l'annuler : previousClanId/newClanId portent les clans du SITE, seuls
// utilisables pour un revert, là où previousPubgClan*/newPubgClan* gardent ce que
// l'API PUBG a réellement renvoyé au moment de la détection.
model PlayerClanChange {
  id String @id @default(cuid())

  pubgAccountId String?
  platformShard String  @default("steam")

  clanMemberId Int?
  clanMember   ClanMember? @relation(fields: [clanMemberId], references: [id], onDelete: SetNull)

  previousClanId Int?
  previousClan   Clan? @relation("PlayerClanChangePrevious", fields: [previousClanId], references: [id], onDelete: SetNull)

  newClanId Int?
  newClan   Clan? @relation("PlayerClanChangeNew", fields: [newClanId], references: [id], onDelete: SetNull)

  previousPubgClanId  String?
  previousPubgClanTag String?
  newPubgClanId       String?
  newPubgClanTag      String?

  // player_sync | auto_demotion | auto_transfer | ungrouped_promotion
  // | player_refresh | manual_demotion | manual_revert
  source String
  // observed | pending | applied | ignored | reverted
  status String @default("applied")

  // Rattachement au passage de cron qui a produit la ligne — indispensable au
  // revert par lot d'un mauvais passage.
  runId String?

  detectedAt DateTime  @default(now())
  appliedAt  DateTime?

  acknowledgedAt       DateTime?
  acknowledgedByUserId Int?
  // Non nul pour les sources manuelles — journal d'audit, même convention que
  // EncounteredPlayerResolutionRun.triggeredByUserId (pas de relation).
  triggeredByUserId    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, detectedAt])
  @@index([clanMemberId])
  @@index([runId])
  @@index([pubgAccountId, platformShard])
  @@map("PlayerClanChange")
}

// Précalcul des awards clan par période, même principe que Clan.clanStats :
// recalculé par le cron nocturne, lu tel quel en lecture — computeClanAwards()
// reste le fallback à la volée si aucune ligne n'existe encore pour ce clan.
model ClanAwardsCache {
  id     String @id @default(cuid())
  clanId Int
  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)

  period     String // 'week' | 'month' | 'all'
  periodKey  String
  payload    Json
  computedAt DateTime @default(now())

  @@unique([clanId, period])
  @@map("ClanAwardsCache")
}

model ClanMatchesCache {
  id     String @id @default(cuid())
  clanId Int
  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)

  period     String // 'week' | 'month' | 'all'
  matchType  String @default("all") // 'official' | 'casual' | 'custom' | 'all'
  periodKey  String
  payload    Json
  computedAt DateTime @default(now())

  @@unique([clanId, period, matchType])
  @@map("ClanMatchesCache")
}

// Agrégats transverses pour le Comparateur de Clans (Méta-Dashboard) : pouls
// d'activité, style de jeu et performances globales par clan et par période.
// Calqué sur ClanMatchesCache/ClanAwardsCache — voir docs/TODO/todo.md,
// section "Idées — Comparateur de Clans (Méta-Dashboard)".
model ClanComparatorCache {
  id     String @id @default(cuid())
  clanId Int
  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)

  period     String // 'week' | 'month' | 'all'
  periodKey  String
  payload    Json
  computedAt DateTime @default(now())

  @@unique([clanId, period])
  @@map("ClanComparatorCache")
}

// Tournois inter-clans declares par un clan organisateur : l'admin du clan
// organisateur heberge chaque match perso (matchType='custom') du tournoi,
// ce qui permet de les decouvrir a partir de son seul compte. N'importe quel
// clan suivi present dans un match ainsi decouvert marque des points pour
// son clan - pas de presequence/selection de clans participants (auto-
// detection totale, voir getTrackedTournamentClanIds). Voir docs/TODO/todo.md,
// section "Idees - Tournois entre clans".
model Tournament {
  id              String @id @default(cuid())
  organizerClanId Int
  organizerClan   Clan   @relation("TournamentOrganizer", fields: [organizerClanId], references: [id], onDelete: Cascade)

  title       String
  description String?

  startDate DateTime
  endDate   DateTime

  gameMode String? // filtre optionnel (ex. squad-fpp) - null = tous modes
  mapName  String? // filtre optionnel - null = toutes cartes

  rules  Json // baremes : placementPoints, killPoints, winBonus, bestOfRounds
  status String @default("draft") // draft | active | finished

  // Surcharge facultative du webhook Discord du clan, pour un tournoi diffuse
  // sur un serveur different de celui des annonces habituelles.
  discordWebhookUrl String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizerClanId, status])
  @@map("Tournament")
}

model UserAccount {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  passwordHash    String
  displayName     String?
  avatarUrl       String?   @db.VarChar(500)
  status          String    @default("active")
  emailVerifiedAt DateTime?
  isSuperUser     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  identities          MemberIdentity[]
  sessions            UserSession[]
  invites             MemberInvite[]
  passwordResetTokens PasswordResetToken[]

  @@map("UserAccount")
}

model MemberIdentity {
  id     Int         @id @default(autoincrement())
  userId Int
  user   UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  memberId Int        @unique
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, memberId])
  @@map("MemberIdentity")
}

model MemberInvite {
  id     String @id @default(cuid())
  clanId Int
  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)

  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  invitedByUserId Int?
  invitedByUser   UserAccount? @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)

  invitedByMemberId Int?
  invitedByMember   ClanMember? @relation("InviteSender", fields: [invitedByMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([memberId, acceptedAt, revokedAt, expiresAt])
  @@index([email, acceptedAt, revokedAt, expiresAt])
  @@map("MemberInvite")
}

model UserSession {
  id     String      @id @default(cuid())
  userId Int
  user   UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  activeMemberId Int?
  activeMember   ClanMember? @relation("SessionActiveMember", fields: [activeMemberId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt, revokedAt])
  @@map("UserSession")
}

model PasswordResetToken {
  id     String      @id @default(cuid())
  userId Int
  user   UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt, usedAt, revokedAt])
  @@map("PasswordResetToken")
}

model ClanRole {
  id     Int  @id @default(autoincrement())
  clanId Int
  clan   Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  name        String
  description String?
  permissions Json

  createdAt DateTime @default(now())

  members ClanMemberRole[]

  @@unique([clanId, name])
  @@map("ClanRole")
}

model ClanMemberRole {
  id       String     @id @default(cuid())
  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  roleId Int
  role   ClanRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())
  assignedBy Int?

  @@unique([memberId, roleId])
  @@map("ClanMemberRole")
}

model Permission {
  id String @id @default(cuid())

  key         String  @unique
  name        String
  description String?
  category    String

  @@map("Permission")
}

model AppConfig {
  key       String   @id
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("AppConfig")
}

model ClanConfig {
  id        Int      @id @default(autoincrement())
  clanId    Int
  clan      Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)
  key       String
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clanId, key])
  @@index([clanId])
  @@map("ClanConfig")
}

// Journal des notifications Discord deja envoyees. La contrainte unique
// (clanId, kind, refId) est le mecanisme de dedoublonnage : une re-sync ou un
// recalcul qui repasse sur le meme match ne peut pas republier l'alerte.
model DiscordNotificationLog {
  id     Int  @id @default(autoincrement())
  clanId Int
  clan   Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  kind  String // top1 | tournament_round
  refId String @db.VarChar(191)

  sentAt DateTime @default(now())

  @@unique([clanId, kind, refId])
  @@index([clanId, sentAt])
