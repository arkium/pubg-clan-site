// Compteur de lancers (grenades, molotov, fumigènes, flashbangs...) par match
// et par membre suivi, depuis LogPlayerUseThrowable. Remplacement idempotent
// (delete+recreate) par squadMatchId, comme DropPressureStat/KillEvent.
/// Objets consommés (`LogItemUse`, catégorie `Use`) par match et par membre suivi : soins, boosts, carburant,
/// gadgets. Le détail par objet vient de `LogItemUse` et non de `LogHeal`, dont l'`itemId` est vide en production.
/// Remplacement idempotent à chaque reparse du match.
model MemberItemUseStat {
  id           String     @id @default(cuid())
  squadMatchId String
  squadMatch   SquadMatch @relation(fields: [squadMatchId], references: [id], onDelete: Cascade)
  memberId     Int
  member       ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  itemId      String
  category    String
  subCategory String
  count       Int
  matchDate   DateTime

  createdAt DateTime @default(now())

  @@unique([squadMatchId, memberId, itemId])
  @@index([memberId, matchDate])
  @@index([subCategory, matchDate])
  @@map("MemberItemUseStat")
}

model MemberThrowableStat {
  id           String     @id @default(cuid())
  squadMatchId String
  squadMatch   SquadMatch @relation(fields: [squadMatchId], references: [id], onDelete: Cascade)
  memberId     Int
  member       ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  itemId    String
  count     Int
  matchDate DateTime

  createdAt DateTime @default(now())

  @@unique([squadMatchId, memberId, itemId])
  @@index([memberId, matchDate])
  @@map("MemberThrowableStat")
}

// Kill-feed : qui a tué qui, pour les matchs impliquant au moins un membre suivi.
// killer/victim peuvent être un membre du clan, un adversaire (EncounteredPlayer),
// ou un bot (accountId préfixé ai.) — resolution faite à la lecture, pas ici.
// Voir docs/TODO/todo.md, section "3. Némésis".
model KillEvent {
  id           String     @id @default(cuid())
  squadMatchId String
  squadMatch   SquadMatch @relation(fields: [squadMatchId], references: [id], onDelete: Cascade)
  clanId       Int
  clan         Clan       @relation(fields: [clanId], references: [id], onDelete: Cascade)

  killerAccountId String?
  killerRawKey    String?
  killerMemberId  Int?
  killerMember    ClanMember? @relation("KillEventKiller", fields: [killerMemberId], references: [id], onDelete: SetNull)

  victimAccountId String?
  victimRawKey    String?
  victimMemberId  Int?
  victimMember    ClanMember? @relation("KillEventVictim", fields: [victimMemberId], references: [id], onDelete: SetNull)

  weaponName       String?
  distance         Float?
  headshot         Boolean  @default(false)
  timestampSeconds Float?
  matchDate        DateTime

  createdAt DateTime @default(now())

  @@index([squadMatchId])
  @@index([clanId, victimMemberId, matchDate])
  @@index([clanId, killerMemberId, matchDate])
  @@map("KillEvent")
}

