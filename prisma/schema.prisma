model SquadMatchTelemetry {
  id           String     @id @default(cuid())
  squadMatchId String     @unique
  squadMatch   SquadMatch @relation(fields: [squadMatchId], references: [id], onDelete: Cascade)

  status             String
  attemptCount       Int       @default(0)
  lastAttemptAt      DateTime?
  nextRetryAt        DateTime?
  parserVersion      String
  parsedAt           DateTime
  sourceGeneratedAt  DateTime?
  contentLength      Int?
  bytesDownloaded    Int?
  summary            Json?
  weaponStats        Json?
  memberStats        Json?
  /// Géolocalisation compressée (gzip du JSON, ~8x). Colonnes ajoutées le 2026-09-24 en
  /// `ALGORITHM=INSTANT` : aucune reconstruction, donc aucun besoin d'espace disque temporaire.
  /// Les colonnes `positionSamples` / `trajectorySegments` en clair sont conservées le temps du
  /// rattrapage. Toute lecture passe par `decodeGeoColumn` (src/lib/pubg-telemetry/geo-codec.ts).
  positionSamples    Json?
  trajectorySegments Json?
  positionSamplesGz    Bytes?
  trajectorySegmentsGz Bytes?
  /// Reste des colonnes JSON, compressees le 2026-09-25 (gzip, ~7,3x). `summary` reste en clair :
  /// cinq routes l'interrogent par JSON_EXTRACT, ce qu'un blob rendrait impossible.
  weaponStatsGz        Bytes?
  memberStatsGz        Bytes?
  deathSamplesGz       Bytes?
  landingSamplesGz     Bytes?
  phaseSnapshotsGz     Bytes?
  killSamplesGz        Bytes?
  shotSamplesGz        Bytes?
  damageSamplesGz      Bytes?
  knockoutSamplesGz    Bytes?
  reviveSamplesGz      Bytes?
  vehicleSamplesGz     Bytes?
  killFeedSamplesGz    Bytes?
  carePackageSamplesGz Bytes?
  deathSamples       Json?
  landingSamples     Json?
  phaseSnapshots     Json?
  killSamples        Json?
  shotSamples        Json?
  damageSamples      Json?
  knockoutSamples    Json?
  reviveSamples      Json?
  vehicleSamples     Json?
  /// Kill-feed complet du lobby (tueur, victime, arme, distance, headshot). `KillEvent` n'en
  /// retient que les frags d'un clan ayant synchronisé le match. Ajouté le 2026-09-14.
  killFeedSamples    Json?
  /// Caisses de largage : largage, atterrissage, contenu notable, pillages. Ajouté le 2026-09-14.
  carePackageSamples Json?
  errorCode          String?
  errorMessage       String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
  @@map("SquadMatchTelemetry")
}

/// Zone sûre (cercle blanc courant) par phase entière d'un match, pour le « cercle moyen » de la page Positions sans
/// relire `SquadMatchTelemetry.phaseSnapshots`. Sommes en pourcentage de la carte : moyenne = somme / snapshotCount.
/// Un match sans zone exploitable reçoit une ligne `phase = 0` vide, pour ne pas être relu à chaque affichage.
model SafeZonePhaseStat {
  id           String     @id @default(cuid())
  squadMatchId String
  squadMatch   SquadMatch @relation(fields: [squadMatchId], references: [id], onDelete: Cascade)

  mapName          String
  matchDate        DateTime
  phase            Int
  snapshotCount    Int
  sumXPercent      Float
  sumYPercent      Float
  sumRadiusPercent Float

  @@unique([squadMatchId, phase])
  @@index([mapName, matchDate])
  @@map("SafeZonePhaseStat")
}

/// Position d'arrivée d'un membre à chaque fermeture de zone (dernier échantillon connu avant l'instant où `isGame`
/// redevient entier). Une ligne par membre, match et fermeture ; les membres morts avant la fermeture n'en ont pas.
/// Persistée au parsing pour survivre à la purge de `positionSamples`.
model ZoneClosurePosition {
  id           String     @id @default(cuid())
  squadMatchId String
  squadMatch   SquadMatch @relation(fields: [squadMatchId], references: [id], onDelete: Cascade)
  clanId       Int
  clan         Clan       @relation(fields: [clanId], references: [id], onDelete: Cascade)
  memberId     Int
  member       ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  mapName   String
  matchDate DateTime
  /// Phase qui commence à la fermeture (2 à 9) : le cercle stable est celui de cette phase.
  phase     Int

  xIndex        Int
  yIndex        Int
  xPercent      Float
  yPercent      Float
  /// Distance au centre du nouveau cercle, divisée par son rayon : < 0,5 centre, <= 1 bord intérieur, > 1 hors zone.
  distanceRatio Float
  zoneBand      String
  /// Joueurs encore en vie dans le lobby à cette fermeture (`numAlivePlayers`).
  survivorCount Int

  createdAt DateTime @default(now())

  @@unique([squadMatchId, memberId, phase])
  @@index([clanId, matchDate, mapName, phase])
  @@index([memberId, matchDate])
  @@map("ZoneClosurePosition")
}

