// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Clan {
  id            Int      @id @default(autoincrement())
  name          String
  tag           String
  platformShard String   @default("steam")
  pubgClanId    String?
  clanStats     Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members ClanMember[]
  roles   ClanRole[]
  reports Report[]
  challenges Challenge[]

  @@unique([name, platformShard])
  @@unique([pubgClanId, platformShard])
  @@map("Clan")
}

model ClanMember {
  id             Int      @id @default(autoincrement())
  displayName    String
  pubgPlayerName String
  pubgAccountId  String?
  platformShard  String   @default("steam")
  isActive       Boolean  @default(true)
  clanId         Int?
  clan           Clan?    @relation(fields: [clanId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  matches                Match[]
  lifetimeStats          MemberLifetimeStats?
  squadMembers           SquadMember[]
  playerStats            PlayerStats[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  roles                  ClanMemberRole[]
  challengeParticipants  ChallengeParticipant[]
  playerRewards          PlayerRewards?

  @@unique([pubgPlayerName, platformShard])
  @@map("ClanMember")
}

model ClanRole {
  id          Int    @id @default(autoincrement())
  clanId      Int
  clan        Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)

  name        String
  description String?
  permissions Json

  createdAt DateTime @default(now())

  members ClanMemberRole[]

  @@unique([clanId, name])
  @@map("ClanRole")
}

model ClanMemberRole {
  id       String     @id @default(cuid())
  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  roleId Int
  role   ClanRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())
  assignedBy Int?

  @@unique([memberId, roleId])
  @@map("ClanMemberRole")
}

model Permission {
  id String @id @default(cuid())

  key         String  @unique
  name        String
  description String?
  category    String

  @@map("Permission")
}

model Notification {
  id       String     @id @default(cuid())
  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  type    String
  title   String
  message String
  data    Json?

  read   Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([memberId, read, createdAt])
  @@map("Notification")
}

model NotificationPreference {
  id       String     @id @default(cuid())
  memberId Int        @unique
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  squadDetected    Boolean @default(true)
  topPerformance   Boolean @default(true)
  challengeStarted Boolean @default(true)
  reportReady      Boolean @default(true)
  inviteReminder   Boolean @default(false)

  emailNotifications Boolean @default(false)
  pushNotifications  Boolean @default(true)
  inAppNotifications Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("NotificationPreference")
}

model Match {
  id       String     @id
  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  pubgMatchId String
  gameMode    String
  mapName     String

  kills         Int
  knockouts     Int
  assists       Int
  damageDealt   Float
  headshotKills Int
  revives       Int

  placement    Int
  playersAlive Int

  duration      Int
  pubgCreatedAt DateTime

  createdAt DateTime @default(now())

  @@unique([memberId, pubgMatchId])
  @@map("Match")
}

model SquadMatch {
  id          String   @id @default(cuid())
  pubgMatchId String   @unique
  gameMode    String
  mapName     String
  placement   Int
  createdAt   DateTime

  members SquadMember[]

  totalKills   Int
  totalDamage  Float
  totalAssists Int
  totalRevives Int

  @@map("SquadMatch")
}

model SquadMember {
  id           String     @id @default(cuid())
  squadMatchId String
  squadMatch   SquadMatch @relation(fields: [squadMatchId], references: [id], onDelete: Cascade)

  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  kills     Int
  damage    Float
  assists   Int
  revives   Int
  placement Int

  @@unique([squadMatchId, memberId])
  @@map("SquadMember")
}

model PlayerStats {
  id         String     @id @default(cuid())
  memberId   Int
  member     ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  period     String // "week-2026-20", "month-2026-05", "all-time"
  periodType String // "week" | "month" | "all"
  startDate  DateTime
  endDate    DateTime

  totalKills       Int   @default(0)
  totalDamage      Float @default(0)
  totalAssists     Int   @default(0)
  totalRevives     Int   @default(0)
  matchesPlayed    Int   @default(0)
  matchesWon       Int   @default(0)
  winRate          Float @default(0)
  avgKillsPerGame  Float @default(0)
  avgDamagePerGame Float @default(0)

  badgeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, period])
  @@map("PlayerStats")
}

model Report {
  id          String   @id @default(cuid())
  clanId      Int
  clan        Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)

  type        String
  periodStart DateTime
  periodEnd   DateTime

  topKiller   Int?
  topDamage   Int?
  bestWinRate Int?
  mvp         Int?

  totalMatches Int
  totalKills   Int
  totalDamage  Float
  avgTeamSize  Float
  avgWinRate   Float

  playerStats Json

  createdAt DateTime @default(now())

  sections ReportSection[]

  @@index([clanId, type, periodStart])
  @@map("Report")
}

model ReportSection {
  id       String @id @default(cuid())
  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  sectionType String
  title       String
  content     Json

  @@map("ReportSection")
}

model MemberLifetimeStats {
  id       Int        @id @default(autoincrement())
  memberId Int        @unique
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  combat   Json
  victory  Json
  support  Json
  vehicle  Json
  movement Json
  other    Json

  lastRefreshedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("MemberLifetimeStats")
}

model Challenge {
  id     String @id @default(cuid())
  clanId Int
  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)

  title       String
  description String?
  type        String

  startDate DateTime
  endDate   DateTime
  duration  String

  target   Int?
  criteria Json

  rewards   Json
  topReward Int?

  status String

  createdAt DateTime @default(now())

  participants ChallengeParticipant[]

  @@index([clanId, status, endDate])
  @@map("Challenge")
}

model ChallengeParticipant {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  progress   Int
  rank       Int?
  reward     Int?

  joinedAt   DateTime  @default(now())
  finishedAt DateTime?

  @@unique([challengeId, memberId])
  @@map("ChallengeParticipant")
}

model ChallengeReward {
  id String @id @default(cuid())

  name        String
  description String?
  icon        String?

  points Int
  badge  String?

  @@map("ChallengeReward")
}

model PlayerRewards {
  id       String     @id @default(cuid())
  memberId Int        @unique
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  totalPoints Int  @default(0)
  badges      Json

  updatedAt DateTime @updatedAt

  @@map("PlayerRewards")
}
