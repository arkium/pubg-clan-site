// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Clan {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  tag             String
  platformShard   String   @default("steam")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members         ClanMember[]

  @@map("Clan")
}

model ClanMember {
  id              Int     @id @default(autoincrement())
  displayName     String
  pubgPlayerName  String  @unique
  pubgAccountId   String?
  platformShard   String  @default("steam")
  isActive        Boolean @default(true)
  clanId          Int?
  clan            Clan?   @relation(fields: [clanId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  matches         Match[]
  lifetimeStats   MemberLifetimeStats?

  @@map("ClanMember")
}

model Match {
  id              String  @id
  memberId        Int
  member          ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  pubgMatchId     String
  gameMode        String
  mapName         String
  
  kills           Int
  knockouts       Int
  assists         Int
  damageDealt     Float
  headshotKills   Int
  revives         Int
  
  placement       Int
  playersAlive    Int
  
  duration        Int
  pubgCreatedAt   DateTime
  
  createdAt       DateTime @default(now())
  
  @@unique([memberId, pubgMatchId])
  @@map("Match")
}

model MemberLifetimeStats {
  id              Int      @id @default(autoincrement())
  memberId        Int      @unique
  member          ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  combat          Json
  victory         Json
  support         Json
  vehicle         Json
  movement        Json
  other           Json

  lastRefreshedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("MemberLifetimeStats")
}