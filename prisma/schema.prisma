// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Clan {
  id                  Int       @id @default(autoincrement())
  name                String
  tag                 String
  platformShard       String    @default("steam")
  pubgClanId          String?
  clanStats           Json?
  clanLevel           Int?
  clanPoints          Int?
  pubgCreatedAt       DateTime?
  pubgMemberCount     Int?
  pubgMembersSyncedAt DateTime?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  members                   ClanMember[]
  roles                     ClanRole[]
  reports                   Report[]
  clanSynergyTelemetryStats ClanSynergyTelemetryStats[]
  challenges                Challenge[]
  invites                   MemberInvite[]
  cronExecutions            CronExecution[]
  clanConfigs               ClanConfig[]
  positionMetricCells       PositionMetricCell[]
  encounteredPlayers        EncounteredPlayer[]
  killEvents                KillEvent[]
  awardsCache               ClanAwardsCache[]

  @@unique([name, platformShard])
  @@unique([pubgClanId, platformShard])
  @@map("Clan")
}

model ClanMember {
  id             Int      @id @default(autoincrement())
  displayName    String
  pubgPlayerName String
  pubgAccountId  String?
  platformShard  String   @default("steam")
  isActive       Boolean  @default(true)
  joinStatus     String   @default("active")
  clanId         Int?
  clan           Clan?    @relation(fields: [clanId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  matches                   Match[]
  lifetimeStats             MemberLifetimeStats?
  seasonStats               MemberSeasonStats[]
  weaponMastery             MemberWeaponMastery[]
  squadMembers              SquadMember[]
  playerStats               PlayerStats[]
  memberWeaponStats         MemberWeaponStats[]
  memberTelemetryStats      MemberTelemetryStats[]
  dropPressureStats         DropPressureStat[]
  positionMetricCells       PositionMetricCell[]
  killEventsAsKiller        KillEvent[]                  @relation("KillEventKiller")
  killEventsAsVictim        KillEvent[]                  @relation("KillEventVictim")
  throwableStats            MemberThrowableStat[]
  telemetrySynergyAsMemberA ClanSynergyTelemetryStats[] @relation("TelemetrySynergyMemberA")
  telemetrySynergyAsMemberB ClanSynergyTelemetryStats[] @relation("TelemetrySynergyMemberB")
  notifications             Notification[]
  notificationPreference    NotificationPreference?
  roles                     ClanMemberRole[]
  challengeParticipants     ChallengeParticipant[]
  playerRewards             PlayerRewards?
  invites                   MemberInvite[]
  identities                MemberIdentity[]
  sentInvites               MemberInvite[]              @relation("InviteSender")
  activeSessions            UserSession[]               @relation("SessionActiveMember")

  @@unique([pubgPlayerName, platformShard])
  @@map("ClanMember")
}

// Adversaires (hors clan suivi) croisés en match par un clan tracké. Table
// volontairement séparée de ClanMember/Clan — sert d'observation légère
// (fréquence de croisement, clan PUBG résolu à la demande), pas de tracking actif.
// Voir docs/TODO/todo.md, section "Idées — Suivi des adversaires rencontrés en match".
model EncounteredPlayer {
  id     String @id @default(cuid())
  clanId Int
  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)

  pubgAccountId  String
  pubgPlayerName String
  platformShard  String

  // Résolution du clan PUBG de ce joueur — nullable tant que non résolu.
  // clanResolvedAt marque qu'une tentative a eu lieu (succès ou "pas de clan"),
  // pour ne jamais rappeler l'API PUBG deux fois pour le même joueur.
  pubgClanId       String?
  pubgClanTag      String?
  pubgClanName     String?
  clanResolvedAt   DateTime?
  resolveAttempts  Int       @default(0)

  encounterCount Int      @default(1)
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clanId, pubgAccountId])
  @@index([clanId, encounterCount])
  @@index([clanId, pubgClanTag])
  @@index([clanResolvedAt, encounterCount])
  @@map("EncounteredPlayer")
}

// Précalcul des awards clan par période, même principe que Clan.clanStats :
// recalculé par le cron nocturne, lu tel quel en lecture — computeClanAwards()
// reste le fallback à la volée si aucune ligne n'existe encore pour ce clan.
model ClanAwardsCache {
  id     String @id @default(cuid())
  clanId Int
  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)

  period     String // 'week' | 'month' | 'all'
  periodKey  String
  payload    Json
  computedAt DateTime @default(now())

  @@unique([clanId, period])
  @@map("ClanAwardsCache")
}

model UserAccount {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  passwordHash    String
  displayName     String?
  avatarUrl       String?
  status          String    @default("active")
  emailVerifiedAt DateTime?
  isSuperUser     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  identities          MemberIdentity[]
  sessions            UserSession[]
  invites             MemberInvite[]
  passwordResetTokens PasswordResetToken[]

  @@map("UserAccount")
}

model MemberIdentity {
  id     Int         @id @default(autoincrement())
  userId Int
  user   UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  memberId Int        @unique
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, memberId])
  @@map("MemberIdentity")
}

model MemberInvite {
  id     String @id @default(cuid())
  clanId Int
  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)

  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  invitedByUserId Int?
  invitedByUser   UserAccount? @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)

  invitedByMemberId Int?
  invitedByMember   ClanMember? @relation("InviteSender", fields: [invitedByMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([memberId, acceptedAt, revokedAt, expiresAt])
  @@index([email, acceptedAt, revokedAt, expiresAt])
  @@map("MemberInvite")
}

model UserSession {
  id     String      @id @default(cuid())
  userId Int
  user   UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  activeMemberId Int?
  activeMember   ClanMember? @relation("SessionActiveMember", fields: [activeMemberId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt, revokedAt])
  @@map("UserSession")
}

model PasswordResetToken {
  id     String      @id @default(cuid())
  userId Int
  user   UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt, usedAt, revokedAt])
  @@map("PasswordResetToken")
}

model ClanRole {
  id     Int  @id @default(autoincrement())
  clanId Int
  clan   Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  name        String
  description String?
  permissions Json

  createdAt DateTime @default(now())

  members ClanMemberRole[]

  @@unique([clanId, name])
  @@map("ClanRole")
}

model ClanMemberRole {
  id       String     @id @default(cuid())
  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  roleId Int
  role   ClanRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())
  assignedBy Int?

  @@unique([memberId, roleId])
  @@map("ClanMemberRole")
}

model Permission {
  id String @id @default(cuid())

  key         String  @unique
  name        String
  description String?
  category    String

  @@map("Permission")
}

model AppConfig {
  key       String   @id
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("AppConfig")
}

model ClanConfig {
  id        Int      @id @default(autoincrement())
  clanId    Int
  clan      Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)
  key       String
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clanId, key])
  @@index([clanId])
  @@map("ClanConfig")
}

model Notification {
  id       String     @id @default(cuid())
  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  type    String
  title   String
  message String
  data    Json?

  read   Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([memberId, read, createdAt])
  @@map("Notification")
}

model NotificationPreference {
  id       String     @id @default(cuid())
  memberId Int        @unique
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  squadDetected    Boolean @default(true)
  topPerformance   Boolean @default(true)
  challengeStarted Boolean @default(true)
  reportReady      Boolean @default(true)
  inviteReminder   Boolean @default(false)

  emailNotifications Boolean @default(false)
  pushNotifications  Boolean @default(true)
  inAppNotifications Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("NotificationPreference")
}

model Match {
  id       String     @id
  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  pubgMatchId String
  gameMode    String
  mapName     String

  kills         Int
  knockouts     Int
  assists       Int
  damageDealt   Float
  headshotKills Int
  revives       Int

  placement    Int
  playersAlive Int

  duration      Int
  pubgCreatedAt DateTime

  // Nombre de bots distincts (accountId préfixé ai.) dans le lobby complet du
  // match — nullable, calculé uniquement pour les matchs synchronisés depuis
  // l'ajout de ce champ, pas de backfill.
  botCount Int?

  createdAt DateTime @default(now())

  @@unique([memberId, pubgMatchId])
  @@map("Match")
}

model SquadMatch {
  id          String   @id @default(cuid())
  pubgMatchId String   @unique
  gameMode    String
  mapName     String
  placement   Int
  createdAt   DateTime

  members             SquadMember[]
  telemetry           SquadMatchTelemetry?
  dropPressureStats   DropPressureStat[]
  positionMetricCells PositionMetricCell[]
  killEvents          KillEvent[]
  throwableStats      MemberThrowableStat[]

  totalKills   Int
  totalDamage  Float
  totalAssists Int
  totalRevives Int

  @@map("SquadMatch")
}

model SquadMember {
  id           String     @id @default(cuid())
  squadMatchId String
  squadMatch   SquadMatch @relation(fields: [squadMatchId], references: [id], onDelete: Cascade)

  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  kills           Int
  damage          Float
  assists         Int
  revives         Int
  placement       Int
  knockouts       Int   @default(0)
  headshotKills   Int   @default(0)
  timeSurvived    Int   @default(0)
  rideDistance    Float @default(0)
  walkDistance    Float @default(0)
  swimDistance    Float @default(0)
  boosts          Int   @default(0)
  heals           Int   @default(0)
  vehicleDestroys Int   @default(0)
  roadKills       Int   @default(0)
  longestKill     Float @default(0)
  teamKills       Int   @default(0)
  weaponsAcquired Int   @default(0)

  @@unique([squadMatchId, memberId])
  @@map("SquadMember")
}

model SquadMatchTelemetry {
  id           String     @id @default(cuid())
  squadMatchId String     @unique
  squadMatch   SquadMatch @relation(fields: [squadMatchId], references: [id], onDelete: Cascade)

  status             String
  attemptCount       Int       @default(0)
  lastAttemptAt      DateTime?
  nextRetryAt        DateTime?
  parserVersion      String
  parsedAt           DateTime
  sourceGeneratedAt  DateTime?
  contentLength      Int?
  bytesDownloaded    Int?
  summary            Json?
  weaponStats        Json?
  memberStats        Json?
  positionSamples    Json?
  trajectorySegments Json?
  deathSamples       Json?
  landingSamples     Json?
  phaseSnapshots     Json?
  killSamples        Json?
  shotSamples        Json?
  damageSamples      Json?
  knockoutSamples    Json?
  reviveSamples      Json?
  vehicleSamples     Json?
  errorCode          String?
  errorMessage       String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
  @@map("SquadMatchTelemetry")
}

model DropPressureStat {
  id           String     @id @default(cuid())
  squadMatchId String
  squadMatch   SquadMatch @relation(fields: [squadMatchId], references: [id], onDelete: Cascade)
  memberId     Int
  member       ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  mapName                 String
  x                       Float
  y                       Float
  matchDate               DateTime
  nearbyPlayerCount250m   Int
  nearbyOpponentCount250m Int?
  pressureLevel           String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([squadMatchId, memberId])
  @@index([memberId, matchDate])
  @@index([matchDate, pressureLevel])
  @@map("DropPressureStat")
}

model PositionMetricCell {
  id           String     @id @default(cuid())
  squadMatchId String
  squadMatch   SquadMatch @relation(fields: [squadMatchId], references: [id], onDelete: Cascade)
  clanId       Int
  clan         Clan       @relation(fields: [clanId], references: [id], onDelete: Cascade)
  memberId     Int
  member       ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  mapName    String
  phase      Int
  metric     String
  xIndex     Int
  yIndex     Int
  eventCount Int
  matchDate  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([squadMatchId, memberId, phase, metric, xIndex, yIndex], map: "PositionMetricCell_match_metric_cell_key")
  @@index([clanId, matchDate, mapName, metric])
  @@index([memberId, matchDate, metric])
  @@index([clanId, mapName, phase, metric])
  @@map("PositionMetricCell")
}

// Compteur de lancers (grenades, molotov, fumigènes, flashbangs...) par match
// et par membre suivi, depuis LogPlayerUseThrowable. Remplacement idempotent
// (delete+recreate) par squadMatchId, comme DropPressureStat/KillEvent.
model MemberThrowableStat {
  id           String     @id @default(cuid())
  squadMatchId String
  squadMatch   SquadMatch @relation(fields: [squadMatchId], references: [id], onDelete: Cascade)
  memberId     Int
  member       ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  itemId    String
  count     Int
  matchDate DateTime

  createdAt DateTime @default(now())

  @@unique([squadMatchId, memberId, itemId])
  @@index([memberId, matchDate])
  @@map("MemberThrowableStat")
}

// Kill-feed : qui a tué qui, pour les matchs impliquant au moins un membre suivi.
// killer/victim peuvent être un membre du clan, un adversaire (EncounteredPlayer),
// ou un bot (accountId préfixé ai.) — resolution faite à la lecture, pas ici.
// Voir docs/TODO/todo.md, section "3. Némésis".
model KillEvent {
  id           String     @id @default(cuid())
  squadMatchId String
  squadMatch   SquadMatch @relation(fields: [squadMatchId], references: [id], onDelete: Cascade)
  clanId       Int
  clan         Clan       @relation(fields: [clanId], references: [id], onDelete: Cascade)

  killerAccountId String?
  killerRawKey    String?
  killerMemberId  Int?
  killerMember    ClanMember? @relation("KillEventKiller", fields: [killerMemberId], references: [id], onDelete: SetNull)

  victimAccountId String?
  victimRawKey    String?
  victimMemberId  Int?
  victimMember    ClanMember? @relation("KillEventVictim", fields: [victimMemberId], references: [id], onDelete: SetNull)

  weaponName       String?
  distance         Float?
  headshot         Boolean  @default(false)
  timestampSeconds Float?
  matchDate        DateTime

  createdAt DateTime @default(now())

  @@index([squadMatchId])
  @@index([clanId, victimMemberId, matchDate])
  @@index([clanId, killerMemberId, matchDate])
  @@map("KillEvent")
}

model PlayerStats {
  id       String     @id @default(cuid())
  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  period     String // "week-2026-20", "month-2026-05", "all-time"
  periodType String // "week" | "month" | "all"
  startDate  DateTime
  endDate    DateTime

  totalKills       Int   @default(0)
  totalDamage      Float @default(0)
  totalAssists     Int   @default(0)
  totalRevives     Int   @default(0)
  matchesPlayed    Int   @default(0)
  matchesWon       Int   @default(0)
  winRate          Float @default(0)
  avgKillsPerGame  Float @default(0)
  avgDamagePerGame Float @default(0)

  badgeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, period])
  @@map("PlayerStats")
}

model MemberWeaponStats {
  id       String     @id @default(cuid())
  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  period     String
  periodType String

  weaponName  String
  kills       Int    @default(0)
  headshots   Int    @default(0)
  shotsFired  Int    @default(0)
  hitsLanded  Int    @default(0)
  avgDistance Float  @default(0)
  maxDistance Float  @default(0)
  totalDamage Float  @default(0)
  matchCount  Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, period, weaponName])
  @@index([period, weaponName])
  @@map("MemberWeaponStats")
}

model MemberTelemetryStats {
  id       String     @id @default(cuid())
  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  period     String
  periodType String

  aggressionScore            Float @default(0)
  supportScore               Float @default(0)
  zoneDisciplineScore        Float @default(0)
  avgBlueZoneHits            Float @default(0)
  avgFirstContactPhase       Float @default(0)
  avgCircleDelaySeconds      Float @default(0)
  avgCircleDelayPercent      Float @default(0)
  avgSafeZonePresencePercent Float @default(0)
  avgOnFootDistanceMeters    Float @default(0)
  avgVehicleDistanceMeters   Float @default(0)
  avgDamageTaken             Float @default(0)
  avgVehicleRideEvents       Float @default(0)
  avgVehicleLeaveEvents      Float @default(0)
  avgPositionEvents          Float @default(0)
  avgHealsUsed               Float @default(0)
  avgHealAmount              Float @default(0)
  avgBoostsUsed              Float @default(0)
  maxVehicleSpeedKph         Float @default(0)
  matchesPlayed              Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, period])
  @@index([period, aggressionScore])
  @@map("MemberTelemetryStats")
}

model ClanSynergyTelemetryStats {
  id     String @id @default(cuid())
  clanId Int
  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)

  memberAId Int
  memberA   ClanMember @relation("TelemetrySynergyMemberA", fields: [memberAId], references: [id], onDelete: Cascade)
  memberBId Int
  memberB   ClanMember @relation("TelemetrySynergyMemberB", fields: [memberBId], references: [id], onDelete: Cascade)

  period     String
  periodType String

  reviveCount        Int @default(0)
  coKillCount        Int @default(0)
  sharedDamageEvents Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clanId, period, memberAId, memberBId])
  @@index([clanId, period])
  @@map("ClanSynergyTelemetryStats")
}

model Report {
  id     String @id @default(cuid())
  clanId Int
  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)

  type        String
  periodStart DateTime
  periodEnd   DateTime

  topKiller   Int?
  topDamage   Int?
  bestWinRate Int?
  mvp         Int?

  totalMatches Int
  totalKills   Int
  totalDamage  Float
  avgTeamSize  Float
  avgWinRate   Float

  playerStats Json

  createdAt DateTime @default(now())

  sections ReportSection[]

  @@index([clanId, type, periodStart])
  @@map("Report")
}

model ReportSection {
  id       String @id @default(cuid())
  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  sectionType String
  title       String
  content     Json

  @@map("ReportSection")
}

model MemberSeasonStats {
  id       Int        @id @default(autoincrement())
  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  seasonId String

  // Ranked mode (best squad/duo/solo mode found)
  rankedGameMode    String?
  rankedTier        String?
  rankedSubTier     String?
  rankedPoints      Float   @default(0)
  rankedBestTier    String?
  rankedBestSubTier String?
  rankedBestPoints  Float   @default(0)
  rankedKills       Int     @default(0)
  rankedDamage      Float   @default(0)
  rankedWins        Int     @default(0)
  rankedMatches     Int     @default(0)
  rankedAssists     Int     @default(0)
  rankedRevives     Int     @default(0)

  // Normal mode (squad aggregated)
  normalKills   Int   @default(0)
  normalDamage  Float @default(0)
  normalWins    Int   @default(0)
  normalLosses  Int   @default(0)
  normalAssists Int   @default(0)
  normalRevives Int   @default(0)
  normalMatches Int   @default(0)

  lastRefreshedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([memberId, seasonId])
  @@map("MemberSeasonStats")
}

model MemberWeaponMastery {
  id       Int        @id @default(autoincrement())
  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  weaponId   String
  weaponName String

  kills               Int   @default(0)
  headshots           Int   @default(0)
  knockouts           Int   @default(0)
  shots               Int   @default(0)
  hits                Int   @default(0)
  damage              Float @default(0)
  longestKillDistance Float @default(0)
  level               Int   @default(0)
  xpTotal             Int   @default(0)
  tier                Int   @default(0)

  lastRefreshedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([memberId, weaponId])
  @@map("MemberWeaponMastery")
}

model MemberLifetimeStats {
  id       Int        @id @default(autoincrement())
  memberId Int        @unique
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  combat   Json
  victory  Json
  support  Json
  vehicle  Json
  movement Json
  other    Json

  statsSquad Json?
  statsDuo   Json?
  statsSolo  Json?

  lastRefreshedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("MemberLifetimeStats")
}

model Challenge {
  id     String @id @default(cuid())
  clanId Int
  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)

  title       String
  description String?
  type        String

  startDate DateTime
  endDate   DateTime
  duration  String

  target   Int?
  criteria Json

  rewards   Json
  topReward Int?

  status String

  createdAt DateTime @default(now())

  participants ChallengeParticipant[]

  @@index([clanId, status, endDate])
  @@map("Challenge")
}

model ChallengeParticipant {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  memberId Int
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  progress Int
  rank     Int?
  reward   Int?

  joinedAt   DateTime  @default(now())
  finishedAt DateTime?

  @@unique([challengeId, memberId])
  @@map("ChallengeParticipant")
}

model ChallengeReward {
  id String @id @default(cuid())

  name        String
  description String?
  icon        String?

  points Int
  badge  String?

  @@map("ChallengeReward")
}

model PlayerRewards {
  id       String     @id @default(cuid())
  memberId Int        @unique
  member   ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  totalPoints Int  @default(0)
  badges      Json

  updatedAt DateTime @updatedAt

  @@map("PlayerRewards")
}

model CronExecution {
  id String @id @default(cuid())

  clanId Int
  clan   Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  action      String
  status      String
  triggeredBy Int?
  source      String @default("manual")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  message String?
  details Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clanId, startedAt])
  @@index([clanId, action, status])
  @@map("CronExecution")
}

model CronSchedule {
  key        String   @id
  expression String
  timezone   String   @default("UTC")
  updatedAt  DateTime @updatedAt
  updatedBy  Int?

  @@map("CronSchedule")
}

model PubgApiCallLog {
  id String @id @default(cuid())

  source String @default("gateway")

  method   String
  endpoint String
  shard    String?

  statusCode Int?
  success    Boolean @default(false)
  retryCount Int     @default(0)

  rateLimitLimit     Int?
  rateLimitRemaining Int?
  rateLimitResetAt   DateTime?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  clanId   Int?
  memberId Int?

  errorMessage String?

  createdAt DateTime @default(now())

  @@index([startedAt])
  @@index([statusCode, startedAt])
  @@index([rateLimitResetAt])
  @@index([source, startedAt])
  @@map("PubgApiCallLog")
}

model NavItem {
  id              Int      @id @default(autoincrement())
  navKey          String   @unique
  section         String
  label           String
  hrefTemplate    String
  defaultRole     String
  description     String   @default("")
  sortOrder       Int      @default(0)
  sectionOverride String?
  roleOverride    String?
  labelOverride   String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([section, sortOrder])
  @@map("NavItem")
}
